# Wiki Agent — Configuração
# Copie para .env e ajuste os valores

# ── Pastas do pipeline legado (Python extractor) ────────────────────
# Executado com `cd` para raiz: python extractor-service/extractor.py
PENDING_DIR=.agent_handoff/pending_python
EXTRACTED_DIR=.agent_handoff/extracted
PROCESSED_DIR=.agent_handoff/processed_python
FAILED_DIR=.agent_handoff/failed

# ── Pastas do pipeline legado (Go wiki-service) ─────────────────────
# Executado de wiki-service/ (onde está main.go)
PROCESSING_DIR=../.agent_handoff/processing
PENDING_PYTHON_DIR=../.agent_handoff/pending_python
EXTRACTED_DIR=../.agent_handoff/extracted
PROCESSED_PYTHON_DIR=../.agent_handoff/processed_python
SUCCESS_DIR=../.agent_handoff/success
FAILED_DIR=../.agent_handoff/failed

# ── Pastas do sistema de agentes ───────────────────────────────────
# Diretório onde Watcher observa novos arquivos com padrão to_AGENT
AGENT_HANDOFF_DIR=../.agent_handoff
# Diretório raiz das configurações de agentes (AGENTS/*.md)
AGENTS_CONFIG_DIR=AGENTS
# Diretório base para saída de processamento de agentes
AGENT_OUTPUT_DIR=output

# ── Chunking semântico ─────────────────────────────────────────────
# Tamanho máximo de cada chunk em tokens estimados (~4 chars/token)
CHUNK_MAX_TOKENS=1000
# Quantos parágrafos de overlap entre chunks consecutivos
# 1 = preserva continuidade sem duplicar muito conteúdo
CHUNK_OVERLAP_PAR=1

# ── Whisper (transcrição de vídeo/áudio) ───────────────────────────
# tiny   → ~2x tempo real no i7  | menos preciso
# small  → ~5x tempo real no i7  | equilibrado (recomendado)
# medium → ~10x tempo real no i7 | mais preciso
WHISPER_MODEL=small

# ── Logging ────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Go — workers e Ollama ──────────────────────────────────────────
WORKER_COUNT=3
EMBED_WORKER_COUNT=5
OLLAMA_URL=http://localhost:11434
OLLAMA_LLM_MODEL=deepseek-r1:7b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_GEMMA_MODEL=gemma4:latest
CODEX_CLI=codex exec --model {{MODEL}} -
CODEX_TIMEOUT_SECONDS=600

# Agentes: provider aceita cli/codex_cli ou ollama. Model e livre por agente.
CEO_AGENT_PROVIDER=ollama
CEO_AGENT_MODEL=deepseek-r1:7b
DEV_BACK_AGENT_PROVIDER=ollama
DEV_BACK_AGENT_MODEL=gemma4:e4b
SECURITY_AGENT_PROVIDER=ollama
SECURITY_AGENT_MODEL=deepseek-r1:7b
QA_AGENT_PROVIDER=ollama
QA_AGENT_MODEL=gemma4:latest
CODE_REVIEWER_AGENT_PROVIDER=ollama
CODE_REVIEWER_AGENT_MODEL=deepseek-r1:7b

# Exemplos Ollama:
# BA_AGENT_PROVIDER=ollama
# BA_AGENT_MODEL=qwen2.5-coder
DB_PATH=src/.runtime/wiki.db
VAULT_PATH=vault
PYTHON_TIMEOUT_MINUTES=60
# Timeout máximo para processamento de cada agente (em segundos)
AGENT_TIMEOUT_SECONDS=1800
